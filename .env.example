# docker-compose.yml için örnek. Kopyalayın: cp .env.example .env
# Alan adınız yoksa: <sunucu-ip-tireli>.sslip.io  (örn. 130-61-12-34.sslip.io)
DOMAIN=pano.ornek.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=degistirin-en-az-8-karakter
DEFAULT_USER_PASSWORD=degistirin-baslangic-parolasi
POSTGRES_PASSWORD=degistirin-uzun-rastgele

# ---- Posta kutusu bağlantısı (Gmail / Outlook) — isteğe bağlı. Adımlar: docs/POSTA-KURULUM.md ----
# MAIL_TOKEN_KEY ya da istemci kimlikleri boşsa özellik kapalıdır (ekranda "Sunucu yapılandırılmamış").
# Erişim anahtarlarını şifreleyen 32 baytlık anahtar: openssl rand -base64 32  (kaybolursa kutular yeniden bağlanır)
MAIL_TOKEN_KEY=
# Google Cloud Console → OAuth istemcisi (Web uygulaması)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft Entra → Uygulama kaydı; kişisel + kurumsal hesaplar için common
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common
# true ise bağlı kutular düzenli çekilir (test ve canlı aynı kutuya bağlanmasın: yalnız birinde true)
MAIL_ENABLED=false
# Kaç saniyede bir çekilsin (30-3600)
MAIL_POLL_SEC=120
